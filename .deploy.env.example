# Copy to .deploy.env (not committed) and fill in for scripts/deploy.sh.
# Needs SSH access to Home Assistant, e.g. the "Advanced SSH & Web Terminal" add-on with your
# public key added to its authorized_keys. Restarting uses the add-on's `ha` command.

HA_HOST=homeassistant.local
HA_USER=root
HA_PORT=22
# HA_CONFIG=/config
